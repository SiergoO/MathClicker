CREATE TABLE IF NOT EXISTS "field" (`id` INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL, `level` INTEGER NOT NULL, `score` INTEGER NOT NULL, `lifeCount` INTEGER NOT NULL, `bonusMultiplier` INTEGER NOT NULL, `currentOperationSign` TEXT NOT NULL, `currentOperationDigit` INTEGER NOT NULL, `nextOperationSign` TEXT NOT NULL, `nextOperationDigit` INTEGER NOT NULL, `isClosed` INTEGER AS kotlin.Boolean NOT NULL, `finishedAt` INTEGER, `gameTimeMs` INTEGER NOT NULL DEFAULT 0, `currentBooster` TEXT, `nextBooster` TEXT, `boosterStash` TEXT NOT NULL DEFAULT '', `boosterDropCounter` INTEGER NOT NULL DEFAULT 0, `hasDroppedBoosterThisSession` INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0);

-- id is nullable here even though the column is NOT NULL: SQLDelight treats an INTEGER PRIMARY
-- KEY as a rowid alias and lets an explicit NULL bind trigger SQLite's autoincrement, matching
-- Room's 0-means-"generate" default on this column.
insertField:
INSERT OR IGNORE INTO field (id, level, score, lifeCount, bonusMultiplier, currentOperationSign, currentOperationDigit, nextOperationSign, nextOperationDigit, isClosed, finishedAt, gameTimeMs, currentBooster, nextBooster, boosterStash, boosterDropCounter, hasDroppedBoosterThisSession)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateField:
UPDATE OR IGNORE field
SET level = ?, score = ?, lifeCount = ?, bonusMultiplier = ?, currentOperationSign = ?, currentOperationDigit = ?, nextOperationSign = ?, nextOperationDigit = ?, isClosed = ?, finishedAt = ?, gameTimeMs = ?, currentBooster = ?, nextBooster = ?, boosterStash = ?, boosterDropCounter = ?, hasDroppedBoosterThisSession = ?
WHERE id = ?;

getFieldById:
SELECT * FROM field WHERE id = ?;

-- Nothing in the schema stops two rows from being open at once (updateSession only inserts when
-- none is, but that is an app-layer invariant, not a constraint). executeAsOneOrNull throws on
-- more than one row, so an ordered LIMIT 1 is required, not optional. The newest by id wins - id
-- is monotonic, and the newest open field is the session the player was actually in. The older
-- one is left untouched here rather than folded into closed history: doing that would fabricate a
-- finish (and a finishedAt) for a run the player never actually ended, and could hand it a bogus
-- entry on the best-score board. It just stays open, permanently excluded from every future call
-- of this query now that it always resolves to the newest row.
getUnfinishedField:
SELECT * FROM field WHERE isClosed = 0 ORDER BY id DESC LIMIT 1;

getFieldCount:
SELECT COUNT(id) FROM field;

-- Ordered by id, not finishedAt: id is monotonic and every row has one, while a pre-MC-53 row has
-- no finishedAt at all - sorting by it would scatter that history to one end instead of keeping it
-- in place among the rows around it.
getRecentClosedFields:
SELECT * FROM field WHERE isClosed = 1 ORDER BY id DESC LIMIT 7;

-- Over all history, not the recent window above: a best run must not stop being the record just
-- because it scrolled past the last seven. Tied scores break on level, not left to insertion order.
getBestClosedField:
SELECT * FROM field WHERE isClosed = 1 ORDER BY score DESC, level DESC LIMIT 1;
